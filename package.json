{
	"name": "mending.js",
	"version": "0.0.1",
	"description": "Ready to mend ?",
	"keywords": [
		"sse",
		"server-sent-events",
		"event-source"
	],
	"homepage": "https://github.com/kisshan13/mending.js#readme",
	"bugs": {
		"url": "https://github.com/kisshan13/mending.js/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kisshan13/mending.js.git"
	},
	"license": "MIT",
	"author": "Kishan Sharma",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./instrumentation": {
			"import": "./dist/instrumentation/index.js",
			"types": "./dist/instrumentation/index.d.ts"
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,cjs,mjs}": [
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"scripts": {
		"dev": "tsc --watch",
		"clean": "rimraf ./dist",
		"build": "rimraf ./dist && tsc --incremental false",
		"prepare": "husky",
		"lint-staged": "lint-staged",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx}\""
	},
	"engines": {
		"node": ">=17.8.0"
	},
	"devDependencies": {
		"@types/lodash": "^4.17.19",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"@typescript-eslint/parser": "^8.35.0",
		"eslint": "^9.30.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"husky": "^9.1.7",
		"ioredis": "^5.5.0",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"lodash": "^4.17.21"
	}
}
